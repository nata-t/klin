{
  "name": "klin-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter create-klin run build",
    "dev": "pnpm --filter create-klin dev",
    "site:dev": "pnpm --filter klin-website dev",
    "site:build": "pnpm --filter klin-website build",
    "site:check": "pnpm --filter klin-website check",
    "test": "pnpm --filter create-klin run test",
    "typecheck": "pnpm --filter create-klin run typecheck",
    "klin": "node packages/create-klin/dist/index.js",
    "playground": "node scripts/playground.mjs",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12"
  }
}
