---
/**
 * The scroll ruler: the page's scrollbar as an instrument (see
 * src/scripts/ruler.ts). Desktop pointers only; everyone else keeps their
 * native scrollbar, and without JavaScript nothing changes at all.
 */
---

<div
  class="assemble fixed inset-y-0 right-0 z-40 w-ruler cursor-crosshair touch-none overflow-hidden font-mono text-bright select-none before-instrument:opacity-0"
  data-ruler
  hidden
></div>

<script>
  import { mountRuler } from "../../scripts/ruler"
  mountRuler(document.querySelector<HTMLElement>("[data-ruler]")!)
</script>
