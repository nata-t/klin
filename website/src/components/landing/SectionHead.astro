---
/** A section's opening: the big mono heading (the `title` slot) and the lede under it. */
---

<div class="grid gap-20 px-gutter pt-[clamp(48px,8vw,96px)] pb-[clamp(32px,5vw,56px)]">
  <h2 class="m-0 max-w-[15em] font-mono text-[clamp(34px,5.6vw,72px)] leading-none font-[620] tracking-[-0.045em] text-balance text-bright" data-reveal><slot name="title" /></h2>
  <p class="m-0 max-w-[34em] text-[clamp(16px,1.4vw,18px)] leading-[1.65] text-pretty text-muted" data-reveal><slot /></p>
</div>
