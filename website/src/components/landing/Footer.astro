---
import KlinLockup from "../brand/KlinLockup.astro"
import Ticks from "./Ticks.astro"
import { NPM, REPO, VERSION } from "../../lib/site"

const link = "w-fit text-[14px] text-muted no-underline hover:text-bright"
---

<footer class="relative border-t border-t-rule">
  <div class="relative mx-auto max-w-rail border-x border-x-rule">
    <Ticks />
    <div class="grid grid-cols-[2fr_1fr_1fr] gap-32 px-gutter pt-56 pb-40 max-720:grid-cols-[1fr_1fr]">
      <div class="max-720:col-span-full">
        <KlinLockup class="m-0 mb-14 block h-30 w-auto text-bright" label="klin" />
        <p class="hud m-0">A spotless full-stack TypeScript starter</p>
      </div>
      <nav class="grid content-start gap-8" aria-label="Docs">
        <p class="hud m-0 mb-6">Docs</p>
        <a class={link} href="/docs/getting-started/">Getting started</a>
        <a class={link} href="/docs/grow/generate/">klin generate</a>
        <a class={link} href="/docs/reference/cli/">CLI reference</a>
        <a class={link} href="/docs/reference/custom-templates/">Custom templates</a>
      </nav>
      <nav class="grid content-start gap-8" aria-label="Project">
        <p class="hud m-0 mb-6">Project</p>
        <a class={link} href={REPO} rel="noopener">GitHub</a>
        <a class={link} href={NPM} rel="noopener">npm</a>
        <a class={link} href="/docs/changelog/">Changelog</a>
        <a class={link} href={`${REPO}/issues`} rel="noopener">Issues</a>
      </nav>
    </div>
    <div class="flex flex-wrap justify-between gap-12 border-t border-t-rule px-gutter py-18">
      <p class="hud m-0">create-klin v{VERSION} · MIT</p>
      <p class="hud m-0">Everything's in its place. Your move.</p>
    </div>
  </div>
</footer>
