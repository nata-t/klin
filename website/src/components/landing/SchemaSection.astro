---
import Button from "./Button.astro"
import Chip from "./Chip.astro"
import Chips from "./Chips.astro"
import FileHeader from "./FileHeader.astro"
import SectionHead from "./SectionHead.astro"
import SectionShell from "./SectionShell.astro"
import { FIELDS } from "../../lib/schema-demo"

// A card lights up as a field's pulse reaches it.
const card =
  "overflow-hidden rounded-box border border-line bg-[rgba(14,14,14,0.85)] transition-[border-color,box-shadow] duration-300 ease-[ease] data-[lit=true]:border-muted data-[lit=true]:shadow-[0_0_0_1px_rgba(255,255,255,0.06),0_0_40px_-12px_rgba(255,255,255,0.18)]"
// The code panes, and the tokens src/scripts/highlight.ts marks: keywords bright, strings muted, comments faint.
// A line that just arrived (.new) flashes.
const code = [
  "m-0 overflow-x-auto px-16 py-14 text-[12.5px] leading-[1.7] text-text [tab-size:2]",
  "[&_.line]:-ml-16 [&_.line]:block [&_.line]:border-l-2 [&_.line]:border-l-transparent [&_.line]:pl-14 [&_.line.new]:animate-fresh",
  "[&_.k]:font-semibold [&_.k]:text-bright [&_.t]:text-bright [&_.s]:text-muted [&_.c]:text-subtle [&_.c]:italic [&_.p]:text-subtle [&_.ok]:text-bright [&_.err]:text-error",
].join(" ")
---

<SectionShell id="schema" index="03" label="One schema" note="packages/validators → form · API · types">
  <SectionHead>
    <Fragment slot="title">Write the shape once.</Fragment>
    In a klin project, one Zod schema validates the form, validates the request, shapes the response and types both apps.
    <code class="text-[0.9em] text-bright">klin generate</code> writes the example <code class="text-[0.9em] text-bright">name</code> field —
    snap on the fields you'd add and watch each one reach every layer.
  </SectionHead>

  <div class="grid gap-22 px-gutter pb-[clamp(64px,9vw,112px)]" data-schema-demo>
    <div class="flex flex-wrap items-center gap-x-18 gap-y-6" data-reveal>
      <p class="hud m-0 text-text">Fields <span class="text-subtle">· pick any</span></p>
      <Chips role="group" aria-label="Fields in the schema">
        {
          FIELDS.map((field) => (
            <Chip
              data-field={field.id}
              aria-pressed={field.always ? "true" : "false"}
              disabled={field.always}
              title={field.always ? "The example field klin generate writes" : undefined}
              mark={field.always ? "◼" : "◻"}
            >
              {field.id}
            </Chip>
          ))
        }
      </Chips>
    </div>

    <div class="relative grid grid-cols-[minmax(0,1.08fr)_minmax(0,1fr)] items-start gap-x-72 gap-y-28 max-960:grid-cols-[1fr]" data-schema-grid>
      <article class:list={[card, "sticky top-[calc(var(--spacing-nav)+60px)] max-960:relative max-960:top-0"]} data-reveal data-schema-source>
        <FileHeader path="packages/validators/src/billing/" file="invoice.ts" />
        <pre class={code} data-schema-code></pre>
      </article>

      <svg class="pointer-events-none absolute inset-0 size-full overflow-visible max-960:hidden" aria-hidden="true" data-wires></svg>

      <div class="grid gap-22">
        <article class:list={[card, "relative"]} data-reveal data-target="form">
          <FileHeader path="apps/web · features/billing/invoice/" file="invoice-form.tsx" />
          <form class="grid gap-14 p-16" data-schema-form novalidate>
            <div class="grid gap-12" data-schema-inputs></div>
            <div class="flex flex-wrap items-center justify-between gap-12">
              <span class="hud tracking-[0.02em] normal-case" data-schema-form-state>validated with createInvoiceSchema</span>
              <Button primary small type="submit">Create invoice</Button>
            </div>
          </form>
        </article>

        <article class:list={[card, "relative"]} data-reveal data-target="api">
          <FileHeader path="apps/api · modules/billing/invoice/" file="invoice.dto.ts" />
          <pre class:list={[code, "border-b border-b-tint whitespace-pre-wrap"]}><span class="k">export class</span> <span class="t">CreateInvoiceDto</span> <span class="k">extends</span> createZodDto(<span class="t">createInvoiceSchema</span>) {"{}"}</pre>
          <div class="grid grid-cols-[1fr_1fr] max-560:grid-cols-[1fr]">
            <pre class:list={[code, "border-r border-r-tint max-560:border-r-0 max-560:border-b max-560:border-b-tint"]} data-schema-request></pre>
            <pre class={code} data-schema-response></pre>
          </div>
        </article>

        <article class:list={[card, "relative"]} data-reveal data-target="types">
          <FileHeader path={"both apps ·\u00a0"} file="z.input<typeof createInvoiceSchema>" />
          <pre class={code} data-schema-type></pre>
        </article>
      </div>
    </div>
  </div>
</SectionShell>

<script>
  import { mountSchemaDemo } from "../../scripts/schema-demo"
  mountSchemaDemo(document.querySelector<HTMLElement>("[data-schema-demo]")!)
</script>

