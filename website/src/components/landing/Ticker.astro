---
// The stack, scrolling past like a marquee. Names only: no logos, no hues.
const parts = [
  "NestJS 12",
  "Express 5",
  "Fastify 5",
  "Better Auth",
  "Prisma",
  "Zod 4",
  "nestjs-zod",
  "TanStack Router",
  "TanStack Query",
  "TanStack Form",
  "Next.js 16",
  "Vite",
  "React 19",
  "shadcn/ui",
  "Turborepo",
  "PostgreSQL",
  "MySQL",
  "SQLite",
  "BullMQ",
  "React Email",
  "Playwright",
  "Vitest",
]
---

<div
  class="group/ticker relative overflow-hidden border-y border-y-rule bg-[rgba(10,10,10,0.5)] [mask-image:linear-gradient(90deg,transparent,#000_10%,#000_90%,transparent)]"
  aria-label="The stack"
>
  <div class="flex w-max animate-slide group-hover/ticker:[animation-play-state:paused]">
    {
      [0, 1].map((copy) => (
        <ul class="m-0 flex list-none p-0" aria-hidden={copy === 1 ? "true" : undefined}>
          {parts.map((part) => (
            <li class="flex items-center gap-22 px-11 py-15 font-mono text-[12px] tracking-[0.14em] whitespace-nowrap text-muted uppercase">
              <span class="text-[9px] text-line" aria-hidden="true">
                ✦
              </span>
              {part}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
