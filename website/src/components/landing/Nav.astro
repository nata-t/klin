---
import KlinLockup from "../brand/KlinLockup.astro"
import { REPO, STEPS, VERSION } from "../../lib/site"
---

<header class="nav" id="site-nav">
  <div class="inner">
    <a class="brand" href="#intro" aria-label="klin, back to the top">
      <KlinLockup class="lockup" />
    </a>

    <nav class="steps" aria-label="Sections">
      <ol>
        {
          STEPS.map((step, i) => (
            <li>
              {i > 0 && <span class="joint" aria-hidden="true" />}
              <a href={`#${step.id}`} data-step={step.id} data-state={i === 0 ? "here" : "ahead"}>
                <span class="mark" aria-hidden="true">
                  {i === 0 ? "◆" : "○"}
                </span>
                <span class="num">{i + 1}</span>
                <span class="name">{step.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="compact" aria-hidden="true">
        <span class="mark">◆</span> <span data-compact-num>1</span>/{STEPS.length} <span data-compact-name>{STEPS[0].label}</span>
      </p>
    </nav>

    <div class="links">
      <a href="/docs/">Docs</a>
      <a href={REPO} rel="noopener">GitHub</a>
      <span class="version">v{VERSION}</span>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-h);
    border-bottom: 1px solid var(--rule);
    background: rgba(20, 20, 20, 0.7);
    backdrop-filter: blur(14px) saturate(1.15);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
  }
  .inner {
    height: 100%;
    max-width: var(--rail);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--text);
    text-decoration: none;
    transition: color 160ms linear;
  }
  .brand:hover {
    color: var(--white);
  }
  .brand .lockup {
    display: block;
    height: 20px;
    width: auto;
  }
  .steps {
    justify-self: center;
    min-width: 0;
  }
  .steps ol {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    display: flex;
    align-items: center;
  }
  .joint {
    width: 22px;
    height: 1px;
    margin: 0 6px;
    background-image: linear-gradient(90deg, var(--line) 50%, transparent 0);
    background-size: 4px 1px;
  }
  .steps a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    border-radius: 3px;
    color: var(--subtle);
    text-decoration: none;
    transition:
      color 160ms linear,
      background-color 160ms linear;
  }
  .steps a:hover {
    background: var(--lift);
    color: var(--text);
  }
  .steps a[data-state="passed"] {
    color: var(--muted);
  }
  .steps a[data-state="here"] {
    color: var(--bright);
    font-weight: 650;
  }
  .steps .mark {
    width: 1ch;
    text-align: center;
  }
  .compact {
    display: none;
    margin: 0;
    color: var(--bright);
  }
  .links {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 120ms linear;
  }
  .links a:hover {
    color: var(--bright);
  }
  .version {
    color: var(--line);
  }
  @media (max-width: 1080px) {
    .steps .name {
      display: none;
    }
    .joint {
      width: 12px;
    }
  }
  @media (max-width: 720px) {
    .steps ol {
      display: none;
    }
    .compact {
      display: block;
    }
    .version {
      display: none;
    }
    .inner {
      gap: 12px;
    }
  }
</style>
