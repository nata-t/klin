---
import KlinLockup from "../brand/KlinLockup.astro"
import { REPO, STEPS, VERSION } from "../../lib/site"

// The nav's three parts assemble one after another at the opening's instrument beat.
const part = "assemble before-instrument:opacity-0 before-instrument:transform-[translateY(-6px)]"
---

<header class="fixed inset-x-0 top-0 z-50 h-nav border-b border-b-rule bg-[rgba(20,20,20,0.7)] backdrop-blur-[14px] backdrop-saturate-[1.15]" id="site-nav">
  <div class="mx-auto grid h-full max-w-rail grid-cols-[auto_1fr_auto] items-center gap-24 px-gutter font-mono text-[11.5px] tracking-[0.12em] uppercase max-720:gap-12">
    <a class:list={[part, "group/hatch inline-flex items-center text-text no-underline hover:text-white"]} href="#intro" aria-label="klin, back to the top">
      <KlinLockup class="block h-20 w-auto" hatch="hover" />
    </a>

    <nav class:list={[part, "min-w-0 justify-self-center delay-80"]} aria-label="Sections">
      <ol class="m-0 flex list-none items-center p-0 max-720:hidden">
        {
          STEPS.map((step, i) => (
            <li class="flex items-center">
              {i > 0 && <span class="mx-6 h-px w-22 bg-[linear-gradient(90deg,var(--color-line)_50%,transparent_0)] bg-size-[4px_1px] max-1080:w-12" aria-hidden="true" />}
              <a
                class="inline-flex items-center gap-6 rounded-[3px] px-6 py-4 text-subtle no-underline transition-[color,background-color] duration-160 ease-linear hover:bg-lift hover:text-text data-[state=here]:font-[650] data-[state=here]:text-bright data-[state=passed]:text-muted"
                href={`#${step.id}`}
                data-step={step.id}
                data-state={i === 0 ? "here" : "ahead"}
              >
                <span class="w-[1ch] text-center" aria-hidden="true" data-mark>
                  {i === 0 ? "◆" : "○"}
                </span>
                <span>{i + 1}</span>
                <span class="max-1080:hidden">{step.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="m-0 hidden text-bright max-720:block" aria-hidden="true">
        <span>◆</span> <span data-compact-num>1</span>/{STEPS.length} <span data-compact-name>{STEPS[0].label}</span>
      </p>
    </nav>

    <div class:list={[part, "flex items-center gap-18 delay-160"]}>
      <a class="text-muted no-underline transition-[color] duration-120 ease-linear hover:text-bright" href="/docs/">Docs</a>
      <a class="text-muted no-underline transition-[color] duration-120 ease-linear hover:text-bright" href={REPO} rel="noopener">GitHub</a>
      <span class="text-line max-720:hidden">v{VERSION}</span>
    </div>
  </div>
</header>
