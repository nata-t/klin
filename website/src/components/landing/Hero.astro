---
import { KLIN } from "@cli/ui/wordmark"
import Button from "./Button.astro"
import Chip from "./Chip.astro"
import Chips from "./Chips.astro"
import Command from "./Command.astro"
import { HERO_GRID } from "../../lib/hero-logo"
import { INSTALL, VERSION } from "../../lib/site"

// The slot keeps the art's shape: the hero grid's square pixels, columns × rows.
const slotShape = `aspect-ratio: ${HERO_GRID.columns} / ${HERO_GRID.rows}`
// No-JS fallback for the canvas logo: KLIN, faces in the chrome gradient, shadows in dark gray.
const faceRows = KLIN.filter((line) => line.includes("█")).length
const shade = (row: number) => Math.round(0xfa - (0xfa - 0xa4) * Math.min(1, row / Math.max(1, faceRows - 1)))
const fallback = KLIN.map((line, row) =>
  [...line].map((ch) => (ch === "█" ? { ch, color: `rgb(${shade(row)},${shade(row)},${shade(row)})` } : { ch, color: "#585858" }))
)

const corner = "hud absolute m-0 text-line tabular-nums"
// The right-hand corners step in from the scroll ruler when it's there.
const right = "right-gutter in-data-ruler:right-[calc(var(--spacing-gutter)+var(--spacing-ruler))]"
// The headline's chrome (white falling to silver) with a band of light that crosses it once, like the CLI logo's intro sweep.
const sheen =
  "bg-[linear-gradient(100deg,transparent_42%,rgba(255,255,255,0.95)_50%,transparent_58%),linear-gradient(180deg,#fafafa_10%,#a4a4a4_95%)] bg-size-[250%_100%,100%_100%] bg-position-[120%_0,0_0] bg-no-repeat bg-clip-text text-transparent data-[sheen=go]:animate-sheen"
const key = "mr-6 inline-block min-w-0 rounded-[4px] border border-b-2 border-line bg-bar px-5 py-0 text-center text-[10px] leading-[1.5] text-text"
---

<section
  id="intro"
  class="group/hero relative isolate flex min-h-[max(720px,100svh)] flex-col justify-center overflow-hidden px-gutter pt-[calc(var(--spacing-nav)+56px)] pb-96"
  data-section="intro"
>
  <canvas class="absolute inset-0 -z-1 size-full" aria-hidden="true"></canvas>

  <div class="assemble delay-200 before-instrument:opacity-0" aria-hidden="true">
    <p class:list={[corner, "top-[calc(var(--spacing-nav)+18px)] left-gutter"]}>create-klin v{VERSION}</p>
    <p class:list={[corner, "top-[calc(var(--spacing-nav)+18px)]", right, "max-560:hidden"]} data-hero-step>◆ 1 / 6 · intro</p>
    <p class:list={[corner, "bottom-22 left-gutter max-860:hidden"]} data-hero-count>parts 0 / 4 snapped</p>
    <p class:list={[corner, "bottom-22", right, "max-860:hidden"]} data-hero-pointer>x 0000 · y 0000</p>
  </div>

  <div class="relative mx-auto flex w-full max-w-920 flex-col items-center text-center">
    <div class="relative mb-[clamp(18px,3vw,34px)] grid w-[min(560px,88%)] cursor-pointer place-items-center" data-logo-slot style={slotShape}>
      <pre class="m-0 text-[clamp(9px,1.6vw,15px)] leading-[1.02] tracking-[0] group-data-[field=on]/hero:invisible" aria-hidden="true">{fallback.map((row) => <span class="block">{row.map((c) => <span style={`color:${c.color}`}>{c.ch}</span>)}</span>)}</pre>
      <span class="sr-only">klin</span>
    </div>

    <h1 class="m-0 font-mono text-[clamp(36px,5.6vw,76px)] leading-none font-[620] tracking-[-0.045em] text-balance text-bright" data-reveal>
      <span class={sheen} data-sheen>Starter kits,</span><br /><span class={sheen} data-sheen>snapped together.</span>
    </h1>

    <p class="m-0 mt-22 max-w-[34em] text-[clamp(16px,1.4vw,18px)] leading-[1.65] text-pretty text-muted" data-reveal>
      One command hands you a TypeScript monorepo — an API, a web app, auth, a database and one set of Zod schemas shared by
      both — wired end to end. Then klin stays in the project to keep it that way.
    </p>

    <div class="mt-28 grid w-[min(560px,100%)] justify-items-center gap-10" data-reveal>
      <Chips role="tablist" aria-label="Package manager" data-pm-tabs>
        {
          Object.keys(INSTALL).map((pm, i) => (
            <Chip role="tab" aria-selected={i === 0 ? "true" : "false"} data-pm={pm} mark={i === 0 ? "●" : "○"}>
              {pm}
            </Chip>
          ))
        }
      </Chips>
      <Command class="w-full text-left" source="data-install-cmd" command={INSTALL.bun} label="Copy the install command" kbd="c" />
    </div>

    <div class="mt-22 flex flex-wrap justify-center gap-12" data-reveal>
      <Button primary href="#wizard" arrow="↓">Try the wizard here</Button>
      <Button href="/docs/getting-started/" arrow="→">Read the docs</Button>
    </div>

    <p class="hud m-0 mt-26" data-reveal>MIT · Node ≥ 22.12 · bun · pnpm · npm · Postgres · MySQL · SQLite</p>
  </div>

  <p class="hud assemble pointer-events-none absolute inset-x-0 bottom-20 m-0 flex flex-wrap justify-center gap-22 delay-500 before-instrument:opacity-0 max-560:hidden" aria-hidden="true">
    <span><kbd class={key}>c</kbd> copy</span>
    <span><kbd class={key}>w</kbd> wizard</span>
    <span><kbd class={key}>d</kbd> docs</span>
  </p>
</section>

<script>
  import { mountHeroField } from "../../scripts/hero-field"
  import { INSTALL } from "../../lib/site"

  const hero = document.querySelector<HTMLElement>("#intro")!
  mountHeroField(hero)

  // Package-manager chips swap the install command.
  const tabs = hero.querySelectorAll<HTMLButtonElement>("[data-pm]")
  const cmd = hero.querySelector<HTMLElement>("[data-install-cmd]")!
  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        const on = t === tab
        t.setAttribute("aria-selected", String(on))
        t.querySelector("[data-mark]")!.textContent = on ? "●" : "○"
      })
      cmd.textContent = INSTALL[tab.dataset.pm as keyof typeof INSTALL]
    })
  )
</script>
