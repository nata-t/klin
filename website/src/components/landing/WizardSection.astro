---
import Button from "./Button.astro"
import Command from "./Command.astro"
import SectionHead from "./SectionHead.astro"
import SectionShell from "./SectionShell.astro"
import WindowDots from "./WindowDots.astro"

// The on-screen keys for touch screens (and anyone who likes buttons).
const pad =
  "h-42 min-w-0 cursor-pointer touch-manipulation rounded-[5px] border border-b-2 border-line bg-tint p-0 font-mono text-[13px] text-bright active:transform-[translateY(1px)] active:bg-lift"
const key = `${pad} flex-1`
const wideKey = `${pad} flex-[1.6]`
---

<SectionShell id="wizard" index="02" label="The wizard" note="Real code · runs in your browser · writes nothing">
  <SectionHead>
    <Fragment slot="title">Try it before<br />you install it.</Fragment>
    This is the actual create-klin wizard — the same code as the CLI, drawing into a terminal on this page. Pick your parts; when
    you build, you get the one command that makes exactly that kit.
  </SectionHead>

  <div class="px-gutter pb-[clamp(56px,8vw,104px)]" data-reveal>
    <div class="group/window overflow-hidden rounded-[10px] border border-line bg-bg shadow-[0_0_0_1px_rgba(0,0,0,0.6),0_40px_120px_-40px_rgba(0,0,0,0.9),0_0_120px_-60px_rgba(255,255,255,0.08)]" data-window>
      <div class="grid grid-cols-[auto_1fr_auto] items-center gap-14 border-b border-b-tint bg-bar px-14 py-9">
        <WindowDots />
        <p class="hud m-0 justify-self-center text-[12px] tracking-[0.04em] text-muted normal-case max-560:invisible">bun create klin <span class="text-subtle">— full-screen</span></p>
        <button
          class="inline-flex cursor-pointer items-center gap-9 rounded-[4px] border border-line bg-transparent px-9 py-3 font-mono text-[10.5px] tracking-[0.12em] text-bright uppercase hover:bg-lift group-data-[awake=true]/window:border-subtle"
          type="button"
          data-term-wake
        >
          <span
            class="size-6 animate-breathe rounded-[50%] bg-subtle group-data-[awake=true]/window:animate-none group-data-[awake=true]/window:bg-bright group-data-[awake=true]/window:shadow-[0_0_8px_rgba(255,255,255,0.6)]"
            aria-hidden="true"></span><span data-wake-label>click to type</span>
          <span class="text-subtle tabular-nums max-560:hidden" data-term-size aria-hidden="true">112 × 34</span>
        </button>
      </div>
      <div
        class="relative cursor-text outline-none data-[awake=true]:shadow-[inset_0_0_0_1px_rgba(255,255,255,0.12)]"
        data-terminal
        role="application"
        aria-roledescription="terminal"
        aria-label="The create-klin wizard. Use the arrow keys to move, space to pick, enter for the next step and escape to go back."
        aria-describedby="wizard-help"
      >
        <canvas class="w-full"></canvas>
        <textarea
          class="pointer-events-none absolute bottom-0 left-0 size-px resize-none border-0 p-0 opacity-0"
          aria-label="Wizard keyboard input"
          autocapitalize="off"
          autocomplete="off"
          spellcheck="false"
          data-term-input></textarea>
        <div class="absolute inset-0 grid animate-overlay-in place-items-center bg-[rgba(12,12,12,0.78)] p-24 backdrop-blur-[5px] [&[hidden]]:hidden" data-term-done hidden>
          <div class="relative grid w-[min(760px,100%)] gap-16 rounded-box border border-line bg-bg px-22 pt-28 pb-22">
            <p class="absolute -top-[0.72em] left-14 m-0 bg-bg px-8 font-mono text-[12px] leading-[1.4] font-semibold whitespace-nowrap text-bright">✦ your kit, in one line</p>
            <p class="hud m-0 text-[12px] tracking-[0.02em] text-muted normal-case">
              Run this in your terminal — the wizard opens with these picks, or <code class="text-bright">-y</code> skips it:
            </p>
            <Command source="data-term-command" small />
            <div class="flex flex-wrap gap-10">
              <Button type="button" data-term-restart>↻ Start over</Button>
              <Button href="/docs/getting-started/" arrow="→">What happens next</Button>
            </div>
          </div>
        </div>
      </div>
      <div class="hidden gap-6 border-t border-t-tint bg-bar p-10 pointer-coarse:flex max-720:flex" aria-label="Wizard keys">
        <button class={key} type="button" data-key="escape">esc</button>
        <button class={key} type="button" data-key="left" aria-label="Left">←</button>
        <button class={key} type="button" data-key="up" aria-label="Up">↑</button>
        <button class={key} type="button" data-key="down" aria-label="Down">↓</button>
        <button class={key} type="button" data-key="right" aria-label="Right">→</button>
        <button class={wideKey} type="button" data-key="space">space</button>
        <button class={wideKey} type="button" data-key="return">enter</button>
      </div>
    </div>
    <p id="wizard-help" class="hud m-0 mt-16 flex flex-wrap justify-center gap-x-22 gap-y-8">
      <span>← ↑ ↓ → move</span><span>space snap</span><span>enter next</span><span>esc back</span><span>type to rename</span>
    </p>
    <pre class="sr-only" aria-live="polite" data-term-text></pre>
  </div>
</SectionShell>

<script>
  import { mountWizard } from "../../wizard/run"
  import { key } from "../../wizard/terminal"
  import { screen } from "../../wizard/shims/term"

  const section = document.getElementById("wizard")!
  const host = section.querySelector<HTMLElement>("[data-terminal]")!
  const input = section.querySelector<HTMLTextAreaElement>("[data-term-input]")!
  const wake = section.querySelector<HTMLButtonElement>("[data-term-wake]")!
  const done = section.querySelector<HTMLElement>("[data-term-done]")!
  const commandEl = section.querySelector<HTMLElement>("[data-term-command]")!
  const sizeEl = section.querySelector<HTMLElement>("[data-term-size]")!
  const textEl = section.querySelector<HTMLElement>("[data-term-text]")!

  const wizard = mountWizard(host, input, {
    started() {
      done.hidden = true
    },
    done(command) {
      commandEl.textContent = command
      done.hidden = false
      done.querySelector<HTMLButtonElement>("[data-copy-from]")?.focus({ preventScroll: true })
    },
    resized(columns, rows) {
      sizeEl.textContent = `${columns} × ${rows}`
    },
  })

  // Start (and play the wordmark's light sweep) when the terminal first comes into view.
  let started = false
  new IntersectionObserver(
    ([entry], observer) => {
      if (!entry!.isIntersecting || started) return
      started = true
      observer.disconnect()
      void wizard.start()
      wizard.playIntro()
    },
    { threshold: 0.35 }
  ).observe(host)

  const windowEl = section.querySelector<HTMLElement>("[data-window]")!
  const wakeLabel = section.querySelector<HTMLElement>("[data-wake-label]")!
  const setAwake = (awake: boolean) => {
    host.dataset.awake = String(awake)
    windowEl.dataset.awake = String(awake)
    wakeLabel.textContent = awake ? "live · tab to leave" : "click to type"
  }
  wake.addEventListener("click", () => {
    if (!started) {
      started = true
      void wizard.start()
    }
    wizard.focus()
  })
  input.addEventListener("focus", () => setAwake(true))
  input.addEventListener("blur", () => setAwake(false))

  section.querySelector("[data-term-restart]")?.addEventListener("click", () => {
    wizard.restart()
    wizard.focus()
  })

  // On-screen keys for touch screens (and anyone who likes buttons).
  section.querySelectorAll<HTMLButtonElement>("[data-key]").forEach((button) =>
    button.addEventListener("click", () => {
      if (!started) {
        started = true
        void wizard.start()
      }
      screen.key(key(button.dataset.key!))
    })
  )

  // Keep a text copy of the screen for assistive tech, a moment after it settles.
  let pending: ReturnType<typeof setTimeout> | undefined
  input.addEventListener("keyup", () => {
    clearTimeout(pending)
    pending = setTimeout(() => (textEl.textContent = wizard.text()), 400)
  })
</script>

