---
import Chip from "./Chip.astro"
import Chips from "./Chips.astro"
import FileHeader from "./FileHeader.astro"
import SectionHead from "./SectionHead.astro"
import SectionShell from "./SectionShell.astro"
import { optionsOf } from "../../lib/manifest"

const labels = (id: string) => optionsOf(id).map((o) => o.label)
const extras = optionsOf("extras")
const pickExtras = (ids: string[]) => extras.filter((o) => ids.includes(o.id)).map((o) => o.label)

const cells = [
  { index: "01", title: "Sign-in", sub: "Better Auth", items: [...labels("auth"), ...labels("plugins")] },
  { index: "02", title: "API", sub: "NestJS or plain", items: [...labels("backend"), ...labels("server"), ...labels("security"), "One error envelope", "pino logs", "Health check"] },
  { index: "03", title: "Web app", sub: "React 19", items: [...labels("web"), "TanStack Query & Form", "shadcn/ui", "Dark mode", "Error, 404 & loading states"] },
  { index: "04", title: "Data", sub: "Prisma", items: [...labels("database"), "Models split by domain", "Seed script", "Prisma Studio"] },
  { index: "05", title: "Modules", sub: "Switch on or off later", items: pickExtras(["email", "uploads", "queues", "i18n"]) },
  { index: "06", title: "Ops", sub: "Turborepo", items: [...pickExtras(["docker", "ci"]), "dev in a split-pane TUI", "husky + commitlint", "Vitest + Playwright"] },
]
const swatches = optionsOf("accent")

const pane = "overflow-hidden rounded-box border border-line bg-[rgba(14,14,14,0.85)]"
const tag = "ml-auto flex-none pl-12 font-mono text-[10.5px] tracking-[0.08em] text-subtle uppercase"
// The strip demo's panes (src/scripts/strip-demo.ts): marker lines faint, lines the picks drop struck out,
// lines that just came back flashing.
const code = [
  "m-0 max-h-560 overflow-auto px-14 py-12 text-[12px] leading-[1.7] text-text",
  "[&_.line]:-ml-14 [&_.line]:block [&_.line]:border-l-2 [&_.line]:border-l-transparent [&_.line]:pl-12 [&_.line]:whitespace-pre [&_.line]:transition-[opacity,color] [&_.line]:duration-250 [&_.line]:ease-[ease]",
  "[&_.marker]:text-subtle [&_.marker_.m]:text-muted [&_.drop]:line-through [&_.drop]:decoration-[rgba(255,255,255,0.25)] [&_.drop]:opacity-32 [&_.new]:animate-fresh-fast",
].join(" ")
---

<SectionShell id="kit" index="04" label="The kit" note={`${cells.reduce((n, c) => n + c.items.length, 0)} parts · ${swatches.length} theme colors`}>
  <SectionHead>
    <Fragment slot="title">Everything a product needs on day one.</Fragment>
    Auth, an API, a dashboard shell, a database, CI and Docker — wired together, tested, and typed end to end. Pick what you need;
    the rest never shows up.
  </SectionHead>

  <div class="grid grid-cols-3 gap-px border-y border-y-rule bg-rule max-1000:grid-cols-2 max-600:grid-cols-1">
    {
      cells.map((cell) => (
        <article class="group/cell bg-bg px-gutter pt-22 pb-28 transition-[background-color] duration-200 ease-[ease] hover:bg-[#171717]" data-reveal>
          <header class="mb-18 flex justify-between gap-12">
            <p class="hud m-0 text-bright group-hover/cell:bg-bright group-hover/cell:text-bg group-hover/cell:shadow-[0_0_0_4px_var(--color-bright)]">
              <span class="mr-6 text-line group-hover/cell:text-subtle">{cell.index}</span> {cell.title}
            </p>
            <p class="hud m-0">{cell.sub}</p>
          </header>
          <ul class="m-0 list-none p-0">
            {cell.items.map((item) => (
              <li class="flex items-baseline gap-10 py-3 font-mono text-[13px] text-text">
                <span class="text-[9px] text-subtle transform-[translateY(-1px)] group-hover/cell:text-bright" aria-hidden="true">
                  ◼
                </span>
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <div class="flex flex-wrap items-center gap-x-28 gap-y-14 border-b border-b-rule px-gutter py-22" data-reveal>
    <p class="hud m-0 text-text">Looks <span class="text-subtle">· shadcn/ui · pick one</span></p>
    <ul class="m-0 flex list-none flex-wrap gap-6 p-0">
      {
        swatches.map((s) => (
          <li class="group/swatch relative" title={s.label}>
            <span
              class="block size-22 rounded-[4px] shadow-[inset_0_0_0_1px_rgba(255,255,255,0.12)] transition-[transform] duration-160 ease-[ease] group-hover/swatch:transform-[translateY(-3px)_scale(1.12)]"
              style={`background:${s.swatch}`}
            />
            <span class="pointer-events-none absolute -top-24 left-1/2 rounded-[3px] bg-bright px-6 py-1 font-mono text-[10.5px] whitespace-nowrap text-bg opacity-0 transition-[opacity] duration-120 ease-linear transform-[translateX(-50%)] group-hover/swatch:opacity-100">
              {s.label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="grid gap-26 px-gutter pt-[clamp(56px,8vw,96px)] pb-[clamp(64px,9vw,112px)]" data-strip-demo>
    <div class="grid gap-16">
      <h3 class="m-0 font-mono text-[clamp(28px,4vw,48px)] leading-none font-[620] tracking-[-0.045em] text-balance text-bright" data-reveal>Only what you picked.</h3>
      <p class="m-0 max-w-[34em] text-[clamp(16px,1.4vw,18px)] leading-[1.65] text-pretty text-muted" data-reveal>
        The template is one real project with every module on. Markers in comments say which lines belong to what, and create-klin
        strips the rest — no dead flags, no <code class="text-[0.9em] text-bright">if (config.enableX)</code>. This is the template's real <code
          class="text-[0.9em] text-bright">auth.ts</code
        >, run through the CLI's own marker engine as you pick.
      </p>
    </div>
    <div class="flex flex-wrap gap-x-48 gap-y-14" data-reveal>
      <div class="grid content-start gap-8">
        <p class="hud m-0 text-text">Database <span class="text-subtle">· pick one</span></p>
        <Chips class="-ml-9" role="radiogroup" aria-label="Database" data-strip-db>
          {
            optionsOf("database").map((o, i) => (
              <Chip role="radio" aria-checked={i === 0 ? "true" : "false"} data-value={o.id} mark={i === 0 ? "●" : "○"}>
                {o.label}
              </Chip>
            ))
          }
        </Chips>
      </div>
      <div class="grid content-start gap-8">
        <p class="hud m-0 text-text">Sign-in & power-ups <span class="text-subtle">· pick any</span></p>
        <Chips class="-ml-9" role="group" aria-label="Sign-in and power-ups" data-strip-flags>
          {
            [...optionsOf("auth"), ...optionsOf("plugins")].map((o) => (
              <Chip aria-pressed={o.id === "password" ? "true" : "false"} data-value={o.id} mark={o.id === "password" ? "◼" : "◻"}>
                {o.label}
              </Chip>
            ))
          }
        </Chips>
      </div>
    </div>
    <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-start gap-18 max-1000:grid-cols-[minmax(0,1fr)]" data-reveal>
      <article class={pane}>
        <FileHeader path="template/packages/auth/src/" file="auth.ts"><span class={tag}>every module on</span></FileHeader>
        <pre class={code} data-strip-source></pre>
      </article>
      <div
        class="grid gap-4 self-center justify-items-center font-mono text-[20px] text-bright max-1000:grid-flow-col max-1000:items-center max-1000:justify-center max-1000:gap-10"
        aria-hidden="true"
      >
        <span class="text-[10px] tracking-[0.12em] text-subtle uppercase">create-klin</span><span class="max-1000:transform-[rotate(90deg)]">→</span>
      </div>
      <article class={pane}>
        <FileHeader path="my-app/packages/auth/src/" file="auth.ts"><span class={tag} data-strip-count></span></FileHeader>
        <pre class={code} data-strip-result></pre>
      </article>
    </div>
  </div>
</SectionShell>

<script>
  import { mountStripDemo } from "../../scripts/strip-demo"
  mountStripDemo(document.querySelector<HTMLElement>("[data-strip-demo]")!)
</script>

