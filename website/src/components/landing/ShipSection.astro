---
import KlinMark from "../brand/KlinMark.astro"
import Button from "./Button.astro"
import Chip from "./Chip.astro"
import Chips from "./Chips.astro"
import Command from "./Command.astro"
import SectionHead from "./SectionHead.astro"
import SectionShell from "./SectionShell.astro"
import { INSTALL, REPO } from "../../lib/site"

const fit = [
  ["SaaS products", "Accounts, teams and billing-shaped data behind a real API."],
  ["Internal tools & dashboards", "Forms, tables and roles, with the boring parts done."],
  ["API-backed apps", "Where a separate backend is a feature — mobile clients, integrations, jobs."],
]
const notFor = [
  ["Static sites & blogs", "There's nothing here you'd use. Reach for a content framework."],
  ["Everything in one Next.js app", "klin can render the web app with Next.js, but the API stays its own app."],
  ["No backend at all", "If you don't want an API, use a framework built for that."],
]
---

<SectionShell id="ship" index="06" label="Ship it" note="MIT · open source">
  <SectionHead>
    <Fragment slot="title">Is it for you?</Fragment>
    klin has opinions. Here's where they help, and where they'd get in your way.
  </SectionHead>

  <div class="grid grid-cols-[1fr_1fr] gap-px border-y border-y-rule bg-rule max-760:grid-cols-[1fr]">
    {
      [
        { label: "Good fit", rows: fit, good: true },
        { label: "Not for", rows: notFor, good: false },
      ].map((col) => (
        <div class="bg-bg px-gutter pt-26 pb-30" data-reveal>
          <p class="hud m-0 mb-18 text-bright">{col.label}</p>
          <ul class="m-0 grid list-none gap-18 p-0">
            {col.rows.map(([title, text]) => (
              <li class="grid grid-cols-[auto_1fr] gap-14">
                <span class:list={["font-mono text-[12px] leading-[1.9]", col.good ? "text-bright" : "text-subtle"]} aria-hidden="true">
                  {col.good ? "◼" : "◻"}
                </span>
                <div>
                  <h3 class:list={["m-0 mb-2 font-mono text-[15px] font-semibold", col.good ? "text-bright" : "text-text"]}>{title}</h3>
                  <p class="m-0 text-[15px] text-muted">{text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div
    class="relative grid justify-items-center overflow-hidden px-gutter pt-[clamp(80px,12vw,160px)] pb-[clamp(88px,12vw,160px)] text-center before:pointer-events-none before:absolute before:inset-x-[15%] before:inset-y-[10%] before:bg-[radial-gradient(closest-side,rgba(255,255,255,0.06),transparent)]"
  >
    <p class="m-0 mb-22 text-bright" aria-hidden="true" data-reveal><KlinMark class="block h-34 w-auto" hatch="loop" /></p>
    <h2
      class="m-0 bg-[linear-gradient(180deg,#fafafa_10%,#a4a4a4_95%)] bg-clip-text font-mono text-[clamp(34px,5.4vw,72px)] leading-none font-[620] tracking-[-0.045em] text-balance text-transparent"
      data-reveal
    >
      Everything's in its place.<br />Your move.
    </h2>
    <div class="mt-36 grid w-[min(560px,100%)] justify-items-center gap-10" data-reveal>
      <Chips role="tablist" aria-label="Package manager" data-final-pm>
        {
          Object.keys(INSTALL).map((pm, i) => (
            <Chip role="tab" aria-selected={i === 0 ? "true" : "false"} data-pm={pm} mark={i === 0 ? "●" : "○"} markClass="font-mono text-[12px] leading-[1.9] text-bright">
              {pm}
            </Chip>
          ))
        }
      </Chips>
      <Command class="w-full text-left" source="data-final-cmd" command={INSTALL.bun} label="Copy the install command" />
    </div>
    <div class="mt-22 flex flex-wrap justify-center gap-12" data-reveal>
      <Button primary href="/docs/getting-started/" arrow="→">Get started</Button>
      <Button href={REPO} rel="noopener" arrow="↗">Star it on GitHub</Button>
    </div>
  </div>
</SectionShell>

<script>
  import { INSTALL } from "../../lib/site"
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-final-pm] [data-pm]")
  const cmd = document.querySelector<HTMLElement>("[data-final-cmd]")!
  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        const on = t === tab
        t.setAttribute("aria-selected", String(on))
        t.querySelector("[data-mark]")!.textContent = on ? "●" : "○"
      })
      cmd.textContent = INSTALL[tab.dataset.pm as keyof typeof INSTALL]
    })
  )
</script>

