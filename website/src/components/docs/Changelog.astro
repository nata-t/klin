---
/** packages/create-klin/CHANGELOG.md, as Changesets writes it — without its "# create-klin" title. */
import * as changelog from "../../../../packages/create-klin/CHANGELOG.md"

const releases = changelog.getHeadings().filter((h) => h.depth === 2)
const { Content } = changelog
---

{
  releases.length ? (
    <div class="[&_h1:first-child]:hidden">
      <Content />
    </div>
  ) : (
    <p class="text-gray-3">No releases yet — the first one is on its way.</p>
  )
}

