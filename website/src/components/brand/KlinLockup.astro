---
// Generated by brand/src/build.mjs — edit the geometry in brand/src/mark.mjs and rebuild.
interface Props {
  class?: string
  /** Set it when the logo stands alone and needs a name; leave it off when text beside it already says "klin". */
  label?: string
  /**
   * Hatch the egg: "hover" while an ancestor with the group/hatch class is hovered, "loop" every few seconds.
   * The animations are theme tokens in ./hatch.css, which the site's stylesheets import.
   */
  hatch?: "hover" | "loop"
}
const { class: className, label, hatch } = Astro.props
// The egg rocks and the cap hops, each pivoting on the bottom of its own box.
const pivot = "origin-bottom transform-fill"
const egg = { hover: "motion-safe:group-hover/hatch:animate-egg-rock", loop: "motion-safe:animate-egg-rock-loop" }
const cap = { hover: "motion-safe:group-hover/hatch:animate-cap-hop", loop: "motion-safe:animate-cap-hop-loop" }
---

<svg
  class={className}
  viewBox="0 0 496 190"
  fill="currentColor"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  data-logo="lockup"
>
  <g data-part="egg" class:list={[pivot, hatch && egg[hatch]]}><g transform="translate(76 114)"><path data-part="shell" d="M-68.57 -44L-54.49 -44L-26 -15.51L0 -41.51L26 -15.51L54.49 -44L68.57 -44A76 102 0 0 1 76 0A76 76 0 0 1 0 76A76 76 0 0 1 -76 0A76 102 0 0 1 -68.57 -44Z"/><path data-part="cap" class:list={[pivot, hatch && cap[hatch]]} d="M-63.52 -68A76 102 0 0 1 63.52 -68L49.51 -68L26 -44.49L0 -70.49L-26 -44.49L-49.51 -68L-63.52 -68Z"/></g></g><path transform="translate(198 190) scale(0.91)" d="M3 -180L23 -180A3 3 0 0 1 26 -177L26 -74.83A2 2 0 0 0 29.41 -73.41L79.12 -123.12A3 3 0 0 1 81.24 -124L106.7 -124A3 3 0 0 1 108.82 -118.88L54.06 -64.12A3 3 0 0 0 54.06 -59.88L108.82 -5.12A3 3 0 0 1 106.7 0L81.24 0A3 3 0 0 1 79.12 -0.88L29.41 -50.59A2 2 0 0 0 26 -49.17L26 -3A3 3 0 0 1 23 0L3 0A3 3 0 0 1 0 -3L0 -177A3 3 0 0 1 3 -180ZM130.94 -180L150.94 -180A3 3 0 0 1 153.94 -177L153.94 -3A3 3 0 0 1 150.94 0L130.94 0A3 3 0 0 1 127.94 -3L127.94 -177A3 3 0 0 1 130.94 -180ZM182.94 -124L202.94 -124A3 3 0 0 1 205.94 -121L205.94 -3A3 3 0 0 1 202.94 0L182.94 0A3 3 0 0 1 179.94 -3L179.94 -121A3 3 0 0 1 182.94 -124ZM179.94 -159A13 13 0 1 1 205.94 -159A13 13 0 1 1 179.94 -159ZM234.94 -124L257.94 -124L257.94 -3A3 3 0 0 1 254.94 0L234.94 0A3 3 0 0 1 231.94 -3L231.94 -121A3 3 0 0 1 234.94 -124ZM231.94 -78A48 48 0 0 1 327.94 -78V-3A3 3 0 0 1 324.94 0H304.94A3 3 0 0 1 301.94 -3V-78A22 22 0 0 0 257.94 -78Z"/>
