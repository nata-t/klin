---
import "@fontsource-variable/geist"
import "@fontsource-variable/geist-mono"
import "../styles/landing.css"
import Nav from "../components/landing/Nav.astro"
import Footer from "../components/landing/Footer.astro"
import ScrollRuler from "../components/landing/ScrollRuler.astro"

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
---

<!doctype html>
<html
  lang="en"
  class="bg-bg [-webkit-text-size-adjust:100%] scheme-dark selection:bg-bright selection:text-bg data-[ruler=on]:[scrollbar-width:none] data-[ruler=on]:[&::-webkit-scrollbar]:hidden data-[ruler=on]:[&::-webkit-scrollbar]:size-0"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141414" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      // Reveal choreography and the opening (src/scripts/intro.ts) only for visitors with JS and motion
      // on; the page is complete without them. If the scripts never arrive, everything shows anyway.
      ;(function () {
        var root = document.documentElement
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
        root.classList.add("motion", "intro")
        setTimeout(function () {
          if (!root.classList.contains("motion-ready")) root.classList.remove("motion", "intro")
        }, 4000)
        setTimeout(function () {
          root.classList.remove("intro")
        }, 9000)
      })()
    </script>
  </head>
  <body
    class="m-0 min-h-screen overflow-x-clip bg-bg bg-[radial-gradient(120%_80%_at_50%_0%,#1a1a1a_0%,#141414_55%,#0f0f0f_100%)] bg-fixed font-sans text-[16px] leading-[1.6] text-text [-webkit-font-smoothing:antialiased] after:pointer-events-none after:fixed after:inset-0 after:z-100 after:bg-(image:--grain) after:opacity-5 in-data-ruler:pr-[clamp(0px,calc(var(--spacing-ruler)_-_(100vw_-_var(--container-rail))_/_2),var(--spacing-ruler))]"
  >
    <a class="absolute -top-60 left-12 z-200 bg-bright px-12 py-8 font-mono text-[13px] text-bg focus:top-12" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ScrollRuler />
    <script>
      import "../scripts/motion"
    </script>
  </body>
</html>
