# ──────────────────────────────────────────────────────────────────────────
#  Klin App — environment
#
#  `.env` is created for you from this file by create-klin, with fresh
#  secrets. Every variable is validated on boot by `packages/env`: a missing
#  or malformed value stops the app with a message naming the culprit.
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=debug

# Origin the web app is served from. Trusted for CORS and auth cookies.
WEB_URL=http://localhost:5173
# Port the API listens on. In dev the web server proxies /api → here.
API_PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────
# klin:if postgres
POSTGRES_USER=klin_app
POSTGRES_PASSWORD=klin_app_dev_password
POSTGRES_DB=klin_app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://klin_app:klin_app_dev_password@localhost:5432/klin_app?schema=public
# klin:elif mysql
#? MYSQL_ROOT_PASSWORD=klin_app_dev_password
#? MYSQL_DATABASE=klin_app
#? MYSQL_PORT=3306
#? DATABASE_URL=mysql://root:klin_app_dev_password@localhost:3306/klin_app
# klin:elif sqlite
#? # Relative file: paths are resolved from the repository root.
#? DATABASE_URL=file:./packages/db/data/dev.db
# klin:endif

# ─── Auth (Better Auth) ───────────────────────────────────────────────────
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Public origin that serves /api/auth. With the built-in proxy that's the web
# origin, so cookies stay first-party in dev and prod.
BETTER_AUTH_URL=http://localhost:5173
# klin:if google

# Google — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# klin:endif
# klin:if github

# GitHub — https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# klin:endif
# klin:if email

# ─── Email (Resend) ───────────────────────────────────────────────────────
# Leave empty in development: emails are printed to the API console instead.
RESEND_API_KEY=
EMAIL_FROM="Klin App <onboarding@resend.dev>"
# klin:endif
# klin:if uploads

# ─── File uploads (any S3-compatible storage) ─────────────────────────────
# Defaults point at the local RustFS container from docker-compose.
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=klin-app-uploads
S3_ACCESS_KEY_ID=klin_app
S3_SECRET_ACCESS_KEY=klin_app_dev_password
S3_FORCE_PATH_STYLE=true
# klin:endif
# klin:if queues

# ─── Background jobs (BullMQ) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# klin:endif

# ─── Web (exposed to the browser — never put secrets in VITE_*) ───────────
# Leave empty to reach the API through the /api proxy (recommended).
# Set it only when the web app and API are deployed on different origins.
VITE_API_URL=
