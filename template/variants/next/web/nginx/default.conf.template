# ${WEB_UPSTREAM} and ${API_UPSTREAM} are filled in from the environment when
# the container starts.
#
# nginx in front of the Next.js server, as Next recommends for self-hosting.
# It records each visitor's address (X-Forwarded-For) — the API's rate limits
# and logs rely on it — and sends /api straight to the API.
server {
  listen 80;
  server_name _;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-Id $request_id;

  # The API (and Better Auth at /api/auth) on the same origin as the app.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    client_max_body_size 2m;
  }

  # Every page, rendered by Next.js.
  location / {
    proxy_pass ${WEB_UPSTREAM};
  }
}
