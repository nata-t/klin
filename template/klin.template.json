{
  "name": "klin",
  "description": "NestJS or plain Express/Fastify + Better Auth + Prisma + TanStack (Router, Query, Form) + shadcn/ui, in a Turborepo with shared Zod validators.",
  "tokens": {
    "klin-app": "slug",
    "klin_app": "snake",
    "Klin App": "title"
  },
  "questions": [
    {
      "id": "backend",
      "type": "select",
      "flag": "backend",
      "message": "How should the API be built?",
      "options": ["nest", "plain"],
      "default": "nest"
    },
    {
      "id": "server",
      "type": "select",
      "flag": "server",
      "message": "Which HTTP server runs it?",
      "options": ["express", "fastify"],
      "default": "express"
    },
    {
      "id": "database",
      "type": "select",
      "flag": "db",
      "message": "Where should your data live?",
      "options": ["postgres", "mysql", "sqlite"],
      "default": "postgres"
    },
    {
      "id": "auth",
      "type": "multiselect",
      "flag": "auth",
      "message": "How should people sign in?",
      "options": ["password", "google", "github", "magic-link", "two-factor", "passkey"],
      "default": ["password"],
      "required": true
    },
    {
      "id": "plugins",
      "type": "multiselect",
      "flag": "plugins",
      "message": "Any Better Auth power-ups?",
      "options": ["organizations", "admin", "api-keys"],
      "default": []
    },
    {
      "id": "security",
      "type": "multiselect",
      "flag": "security",
      "message": "Which API safeguards?",
      "options": ["cors", "helmet", "rate-limit"],
      "default": ["cors", "helmet", "rate-limit"]
    },
    {
      "id": "extras",
      "type": "multiselect",
      "flag": "extras",
      "message": "Extras for the toolbox?",
      "options": ["email", "uploads", "queues", "i18n", "docker", "ci"],
      "default": ["docker", "ci"]
    },
    {
      "id": "components",
      "type": "select",
      "flag": "components",
      "message": "Where should shadcn/ui components live?",
      "options": ["apps-web", "packages-ui"],
      "default": "apps-web"
    },
    {
      "id": "accent",
      "type": "select",
      "flag": "accent",
      "message": "Pick a theme color",
      "options": [
        "neutral",
        "amber",
        "blue",
        "cyan",
        "emerald",
        "fuchsia",
        "green",
        "indigo",
        "lime",
        "orange",
        "pink",
        "purple",
        "red",
        "rose",
        "sky",
        "teal",
        "violet",
        "yellow"
      ],
      "default": "neutral",
      "flagPrefix": "accent-"
    }
  ],
  "options": {
    "nest": {
      "label": "NestJS",
      "hint": "modules, DI, nestjs-zod DTOs",
      "json": {
        "apps/api/package.json": {
          "dependencies": [
            "@nestjs/common",
            "@nestjs/core",
            "@thallesp/nestjs-better-auth",
            "nestjs-pino",
            "nestjs-zod",
            "reflect-metadata",
            "rxjs"
          ],
          "devDependencies": ["@swc/core"]
        },
        "package.json": {
          "trustedDependencies": ["@swc/core"]
        }
      }
    },
    "plain": {
      "label": "Plain",
      "hint": "no framework, just routes"
    },
    "express": {
      "label": "Express",
      "hint": "the classic, huge ecosystem",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["helmet"],
          "devDependencies": ["@types/express"]
        }
      }
    },
    "fastify": {
      "label": "Fastify",
      "hint": "faster, schema-first",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["@fastify/helmet"]
        }
      }
    },
    "password": {
      "label": "Email & password",
      "hint": "sign up, reset & verify flows"
    },
    "google": {
      "label": "Google",
      "hint": "OAuth",
      "note": "Add GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET to .env to switch on Google sign-in"
    },
    "github": {
      "label": "GitHub",
      "hint": "OAuth",
      "note": "Add GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET to .env to switch on GitHub sign-in"
    },
    "magic-link": {
      "label": "Magic link",
      "hint": "passwordless email links"
    },
    "two-factor": {
      "label": "Two-factor (TOTP)",
      "hint": "authenticator apps + backup codes",
      "requires": ["password"],
      "remove": [
        "apps/web/src/routes/_auth/two-factor.tsx",
        "apps/web/src/features/auth/two-factor-*.tsx",
        "apps/web/src/features/settings/two-factor-card.tsx"
      ],
      "json": {
        "apps/web/package.json": {
          "dependencies": ["react-qr-code"]
        }
      }
    },
    "passkey": {
      "label": "Passkeys",
      "hint": "Face ID, Touch ID, security keys",
      "remove": ["apps/web/src/features/settings/passkeys-card.tsx"],
      "json": {
        "packages/auth/package.json": {
          "dependencies": ["@better-auth/passkey"]
        },
        "apps/api/package.json": {
          "dependencies": ["@better-auth/passkey"]
        }
      }
    },
    "organizations": {
      "label": "Organizations & RBAC",
      "hint": "teams, invites, roles, permissions",
      "remove": [
        "apps/api/src/modules/organization/**",
        "apps/api/plain-*/routes/organization.ts",
        "apps/api/plain/services/organization.ts",
        "apps/web/src/features/organizations/**",
        "apps/web/src/routes/_app/settings/organization.tsx",
        "apps/web/src/routes/accept-invitation.$invitationId.tsx",
        "packages/docs/organizations.md"
      ]
    },
    "admin": {
      "label": "Admin dashboard",
      "hint": "manage users, ban, impersonate",
      "remove": [
        "apps/api/src/modules/admin/**",
        "apps/api/plain-*/routes/admin.ts",
        "apps/api/plain/services/admin.ts",
        "apps/web/src/features/admin/**",
        "apps/web/src/routes/_app/admin.tsx",
        "apps/web/src/routes/_app/admin/**"
      ]
    },
    "api-keys": {
      "label": "API keys",
      "hint": "let users call your API from scripts",
      "remove": ["apps/web/src/features/api-keys/**", "apps/web/src/routes/_app/settings/api-keys.tsx"],
      "json": {
        "packages/auth/package.json": {
          "dependencies": ["@better-auth/api-key"]
        },
        "apps/api/package.json": {
          "dependencies": ["@better-auth/api-key"]
        }
      }
    },
    "postgres": {
      "label": "PostgreSQL",
      "hint": "recommended",
      "json": {
        "packages/db/package.json": {
          "dependencies": ["@prisma/adapter-pg"]
        },
        "apps/api/package.json": {
          "dependencies": ["@prisma/adapter-pg"]
        }
      }
    },
    "mysql": {
      "label": "MySQL",
      "hint": "or MariaDB",
      "json": {
        "packages/db/package.json": {
          "dependencies": ["@prisma/adapter-mariadb"]
        },
        "apps/api/package.json": {
          "dependencies": ["@prisma/adapter-mariadb"]
        }
      }
    },
    "sqlite": {
      "label": "SQLite",
      "hint": "zero setup, a file on disk",
      "remove": ["packages/db/data/.gitkeep"],
      "json": {
        "packages/db/package.json": {
          "dependencies": ["@prisma/adapter-better-sqlite3"]
        },
        "apps/api/package.json": {
          "dependencies": ["@prisma/adapter-better-sqlite3"]
        }
      }
    },
    "cors": {
      "label": "CORS",
      "hint": "only your web app may call the API"
    },
    "helmet": {
      "label": "Helmet",
      "hint": "secure HTTP headers"
    },
    "rate-limit": {
      "label": "Rate limiting",
      "hint": "120 requests / minute / IP"
    },
    "email": {
      "label": "Transactional email",
      "hint": "Resend + React Email",
      "remove": ["packages/email/**", "packages/docs/email.md"],
      "json": {
        "package.json": {
          "scripts": ["email:dev"]
        },
        "packages/auth/package.json": {
          "dependencies": ["@repo/email"],
          "devDependencies": ["@types/react", "react"]
        },
        "apps/api/package.json": {
          "dependencies": [
            "@repo/email",
            "@react-email/components",
            "@react-email/render",
            "react",
            "react-dom",
            "resend"
          ]
        }
      }
    },
    "uploads": {
      "label": "File uploads",
      "hint": "S3 / R2 presigned URLs",
      "remove": [
        "apps/api/src/modules/uploads/**",
        "apps/api/plain-*/routes/uploads.ts",
        "apps/api/plain/services/uploads.ts",
        "apps/web/src/features/uploads/**",
        "packages/docs/uploads.md"
      ],
      "json": {
        "apps/api/package.json": {
          "dependencies": ["@aws-sdk/client-s3", "@aws-sdk/s3-request-presigner"]
        }
      }
    },
    "queues": {
      "label": "Background jobs",
      "hint": "BullMQ + Redis",
      "remove": [
        "apps/api/src/modules/jobs/**",
        "apps/api/plain-*/routes/jobs.ts",
        "apps/api/plain/jobs/**",
        "packages/docs/background-jobs.md"
      ],
      "json": {
        "apps/api/package.json": {
          "dependencies": ["@nestjs/bullmq", "bullmq", "ioredis"]
        }
      }
    },
    "i18n": {
      "label": "Internationalization",
      "hint": "i18next, English to start",
      "remove": ["apps/web/src/i18n/**", "apps/web/src/components/language-switcher.tsx"],
      "json": {
        "apps/web/package.json": {
          "dependencies": ["i18next", "react-i18next"]
        }
      }
    },
    "docker": {
      "label": "Docker",
      "hint": "local services + production images",
      "remove": [
        "**/Dockerfile",
        "**/docker-entrypoint.sh",
        "apps/web/nginx/**",
        ".dockerignore",
        "docker-compose.prod.yml"
      ]
    },
    "ci": {
      "label": "GitHub Actions + Renovate",
      "hint": "lint, typecheck, test, build, e2e",
      "remove": [".github/**", "renovate.json"]
    },
    "apps-web": {
      "label": "apps/web",
      "hint": "next to your app"
    },
    "packages-ui": {
      "label": "packages/ui",
      "hint": "a shared @repo/ui package",
      "remove": ["variants/packages-ui/**"]
    },
    "neutral": {
      "label": "Neutral",
      "swatch": "oklch(0.922 0 0)"
    },
    "amber": {
      "label": "Amber",
      "swatch": "oklch(0.473 0.137 46.201)"
    },
    "blue": {
      "label": "Blue",
      "swatch": "oklch(0.424 0.199 265.638)"
    },
    "cyan": {
      "label": "Cyan",
      "swatch": "oklch(0.45 0.085 224.283)"
    },
    "emerald": {
      "label": "Emerald",
      "swatch": "oklch(0.432 0.095 166.913)"
    },
    "fuchsia": {
      "label": "Fuchsia",
      "swatch": "oklch(0.452 0.211 324.591)"
    },
    "green": {
      "label": "Green",
      "swatch": "oklch(0.448 0.119 151.328)"
    },
    "indigo": {
      "label": "Indigo",
      "swatch": "oklch(0.398 0.195 277.366)"
    },
    "lime": {
      "label": "Lime",
      "swatch": "oklch(0.768 0.233 130.85)"
    },
    "orange": {
      "label": "Orange",
      "swatch": "oklch(0.47 0.157 37.304)"
    },
    "pink": {
      "label": "Pink",
      "swatch": "oklch(0.459 0.187 3.815)"
    },
    "purple": {
      "label": "Purple",
      "swatch": "oklch(0.438 0.218 303.724)"
    },
    "red": {
      "label": "Red",
      "swatch": "oklch(0.444 0.177 26.899)"
    },
    "rose": {
      "label": "Rose",
      "swatch": "oklch(0.455 0.188 13.697)"
    },
    "sky": {
      "label": "Sky",
      "swatch": "oklch(0.443 0.11 240.79)"
    },
    "teal": {
      "label": "Teal",
      "swatch": "oklch(0.437 0.078 188.216)"
    },
    "violet": {
      "label": "Violet",
      "swatch": "oklch(0.432 0.232 292.759)"
    },
    "yellow": {
      "label": "Yellow",
      "swatch": "oklch(0.795 0.184 86.047)"
    }
  },
  "flags": {
    "scaffolded": "pnpm || bun || npm",
    "oauth": "google || github",
    "sends-auth-email": "password || magic-link || organizations",
    "compose": "docker && (postgres || mysql || queues || uploads)",
    "settings-security": "password || two-factor || passkey",
    "nest-express": "nest && express",
    "nest-fastify": "nest && fastify",
    "plain-express": "plain && express",
    "plain-fastify": "plain && fastify"
  },
  "rules": [
    {
      "when": "!pnpm",
      "remove": ["pnpm-workspace.yaml"]
    },
    {
      "when": "pnpm",
      "json": {
        "package.json": {
          "workspaces": true
        }
      }
    },
    {
      "when": "!bun",
      "json": {
        "package.json": {
          "trustedDependencies": true
        }
      }
    },
    {
      "when": "!npm || !nest",
      "json": {
        "package.json": {
          "overrides": true
        }
      }
    },
    {
      "when": "!compose",
      "remove": ["docker-compose.yml"],
      "json": {
        "package.json": {
          "scripts": ["db:up", "db:down"]
        }
      }
    },
    {
      "when": "nest",
      "remove": ["apps/api/plain/**", "apps/api/plain-express/**", "apps/api/plain-fastify/**"]
    },
    {
      "when": "plain",
      "remove": ["apps/api/src/*/**", "apps/api/src/main.ts", "apps/api/src/app.module.ts", "apps/api/src/logger.module.ts"],
      "move": {
        "apps/api/plain/": "apps/api/src/",
        "apps/api/plain-express/": "apps/api/src/",
        "apps/api/plain-fastify/": "apps/api/src/"
      }
    },
    {
      "when": "plain && !express",
      "remove": ["apps/api/plain-express/**"]
    },
    {
      "when": "plain && !fastify",
      "remove": ["apps/api/plain-fastify/**"]
    },
    {
      "when": "!nest-express",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["@nestjs/platform-express"]
        }
      }
    },
    {
      "when": "!nest-fastify",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["@nestjs/platform-fastify"]
        }
      }
    },
    {
      "when": "!plain-express",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["cors", "express", "express-rate-limit"],
          "devDependencies": ["@types/cors"]
        }
      }
    },
    {
      "when": "!plain-fastify",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["@fastify/cors", "@fastify/rate-limit", "fastify"]
        }
      }
    },
    {
      "when": "!nest && !express",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["pino-http"]
        }
      }
    },
    {
      "when": "!nest || !queues",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["@nestjs/bullmq"]
        }
      }
    },
    {
      "when": "!nest || !rate-limit",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["@nestjs/throttler"]
        }
      }
    },
    {
      "when": "!helmet",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["@fastify/helmet", "helmet"]
        }
      }
    },
    {
      "when": "!cors",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["@fastify/cors", "cors"],
          "devDependencies": ["@types/cors"]
        }
      }
    },
    {
      "when": "!rate-limit",
      "json": {
        "apps/api/package.json": {
          "dependencies": ["@fastify/rate-limit", "express-rate-limit"]
        }
      }
    },
    {
      "when": "packages-ui",
      "remove": [
        "apps/web/components.json"
      ],
      "move": {
        "variants/packages-ui/ui/": "packages/ui/",
        "variants/packages-ui/web/": "apps/web/",
        "apps/web/src/components/ui/": "packages/ui/src/components/",
        "apps/web/src/components/theme-provider.tsx": "packages/ui/src/components/theme-provider.tsx",
        "apps/web/src/lib/utils.ts": "packages/ui/src/lib/utils.ts",
        "apps/web/src/hooks/use-mobile.ts": "packages/ui/src/hooks/use-mobile.ts",
        "apps/web/src/styles.css": "packages/ui/src/styles/globals.css"
      },
      "replace": [
        {
          "files": ["apps/web/**/*.{ts,tsx}", "packages/ui/src/**/*.{ts,tsx}"],
          "from": "\"@/components/ui/",
          "to": "\"@repo/ui/components/"
        },
        {
          "files": ["apps/web/**/*.{ts,tsx}", "packages/ui/src/**/*.{ts,tsx}"],
          "from": "\"@/components/theme-provider\"",
          "to": "\"@repo/ui/components/theme-provider\""
        },
        {
          "files": ["apps/web/**/*.{ts,tsx}", "packages/ui/src/**/*.{ts,tsx}"],
          "from": "\"@/lib/utils\"",
          "to": "\"@repo/ui/lib/utils\""
        },
        {
          "files": ["apps/web/**/*.{ts,tsx}", "packages/ui/src/**/*.{ts,tsx}"],
          "from": "\"@/hooks/use-mobile\"",
          "to": "\"@repo/ui/hooks/use-mobile\""
        }
      ],
      "merge": {
        "apps/web/package.json": {
          "dependencies": { "@repo/ui": "workspace:*" }
        }
      },
      "json": {
        "apps/web/package.json": {
          "dependencies": ["@base-ui/react", "class-variance-authority", "clsx", "tailwind-merge", "@fontsource-variable/inter"],
          "devDependencies": ["tw-animate-css"]
        }
      }
    }
  ],
  "presets": {
    "recommended": {
      "label": "Recommended",
      "hint": "email & password, Postgres, Docker, CI",
      "answers": {}
    },
    "saas": {
      "label": "SaaS starter",
      "hint": "OAuth, 2FA, teams, admin, email, uploads, jobs",
      "answers": {
        "auth": ["password", "google", "github", "two-factor"],
        "plugins": ["organizations", "admin"],
        "extras": ["email", "uploads", "queues", "docker", "ci"]
      }
    },
    "minimal": {
      "label": "Featherweight",
      "hint": "plain Fastify on SQLite, no Docker",
      "answers": {
        "backend": "plain",
        "server": "fastify",
        "auth": ["password"],
        "database": "sqlite",
        "extras": []
      }
    },
    "everything": {
      "label": "Kitchen sink",
      "hint": "every module, so you can see it all",
      "answers": {
        "auth": ["password", "google", "github", "magic-link", "two-factor", "passkey"],
        "plugins": ["organizations", "admin", "api-keys"],
        "extras": ["email", "uploads", "queues", "i18n", "docker", "ci"]
      }
    }
  },
  "env": {
    "generate": {
      "BETTER_AUTH_SECRET": "secret",
      "POSTGRES_PASSWORD": "password",
      "MYSQL_ROOT_PASSWORD": "password",
      "S3_SECRET_ACCESS_KEY": "password"
    }
  }
}
