{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "API_PORT",
    "CI",
    "DATABASE_URL",
    "NODE_ENV",
    "PLAYWRIGHT_*",
    "WEB_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      // klin:if next
      //? "env": ["API_URL", "NEXT_OUTPUT"],
      //? "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
      // klin:else
      "env": ["VITE_*"],
      "outputs": ["dist/**"]
      // klin:endif
    },
    "dev": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "db:generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
